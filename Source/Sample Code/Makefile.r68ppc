
all:
	make -C GLUT -f Makefile.r68ppc
	make -C Intros -f Makefile.r68ppc
	make -C Multi-Texture\ CVA -f Makefile.r68ppc
	make -C OpenGL\ DrawSprocket -f Makefile.r68ppc
	make -C Renderer\ Info -f Makefile.r68ppc
	
clean:
	make -C GLUT -f Makefile.r68ppc clean
	make -C Intros -f Makefile.r68ppc clean
	make -C Multi-Texture\ CVA -f Makefile.r68ppc clean
	make -C OpenGL\ DrawSprocket -f Makefile.r68ppc clean
	make -C Renderer\ Info -f Makefile.r68ppc clean
