
#CC=m68k-apple-macos-gcc
#CXX=m68k-apple-macos-g++
CC=powerpc-apple-macos-gcc
CXX=powerpc-apple-macos-g++

CFLAGS= -I../../../../Headers
LDFLAGS= -lglut -lOpenGLUtility -lOpenGLLibrary -lDrawSprocketLib -lContextualMenu -lm

OBJS=$(subst .c,.o,$(wildcard *.c))

.c.o:
	$(CC) $(CFLAGS) -c -o $@ $<

all: $(OBJS)
#	$(CXX) -o logo.code.bin $(OBJS) $(LDFLAGS)
#	../bin2app.sh logo
	$(CC) -o logo $(OBJS) $(LDFLAGS)
	../xcoff2app.sh logo

clean:
	rm -f *.o *.bin *.pef *.APPL *.dsk *.gdb logo
