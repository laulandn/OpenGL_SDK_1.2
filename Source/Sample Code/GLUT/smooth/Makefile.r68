
CC=m68k-apple-macos-gcc
CXX=m68k-apple-macos-g++
#CC=powerpc-apple-macos-gcc
#CXX=powerpc-apple-macos-g++

CFLAGS= -I../../../../Headers
LDFLAGS= -lglut -lOpenGLUtility -lOpenGLLibrary -lDrawSprocketLib -lm

OBJS=$(subst .c,.o,$(wildcard *.c))

.c.o:
	$(CC) $(CFLAGS) -c -o $@ $<

all: $(OBJS)
	$(CXX) -o smooth.code.bin $(OBJS) $(LDFLAGS)
	../bin2app.sh smooth
#	$(CC) -o smooth $(OBJS) $(LDFLAGS)
#	../xcoff2app.sh smooth

clean:
	rm -f *.o *.bin *.pef *.APPL *.dsk *.gdb smooth
