
all:
	make -C GLUT -f Makefile.r68
	make -C Intros -f Makefile.r68
	make -C Multi-Texture\ CVA -f Makefile.r68
	make -C OpenGL\ DrawSprocket -f Makefile.r68
	make -C Renderer\ Info -f Makefile.r68
	
clean:
	make -C GLUT -f Makefile.r68 clean
	make -C Intros -f Makefile.r68 clean
	make -C Multi-Texture\ CVA -f Makefile.r68 clean
	make -C OpenGL\ DrawSprocket -f Makefile.r68 clean
	make -C Renderer\ Info -f Makefile.r68 clean
